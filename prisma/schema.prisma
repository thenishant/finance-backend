generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String?
  authProvider     AuthProvider       @default(EMAIL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categories       Category[]
  transactions     Transaction[]
  investmentGoals  InvestmentGoal[]
  monthlyAnalytics MonthlyAnalytics[]
  ledgerEntries    LedgerEntry[]

  gmailAccount      GmailAccount?
  financialAccounts FinancialAccount[]
}

model Category {
  id           String          @id @default(uuid())
  userId       String
  name         String
  type         TransactionType
  parentId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]      @relation("CategoryTree")
  transactions Transaction[]

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
}

model Transaction {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 TransactionType
  amount               Decimal           @db.Decimal(18, 2)
  originalAmount       Decimal?          @db.Decimal(18, 2)
  date                 DateTime
  year                 Int
  month                Int
  merchant             String?
  note                 String?
  categoryId           String?
  category             Category?         @relation(fields: [categoryId], references: [id])
  sourceAccountId      String?
  destinationAccountId String?
  sourceAccount        FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount   FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  source               TransactionSource @default(MANUAL)
  externalReference    String?
  fingerprint          String?           @unique
  gmailMessageId       String?
  gmailMessage         GmailMessage?     @relation(fields: [gmailMessageId], references: [id])
  idempotencyKey       String?           @unique
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  ledgerEntries        LedgerEntry[]
  status               TransactionStatus @default(COMPLETED)
  currency             String            @default("INR")
  exchangeRate         Decimal?          @db.Decimal(18, 6)
  merchantNormalized   String?

  @@index([userId])
  @@index([date])
  @@index([userId, year])
  @@index([userId, year, month])
  @@index([userId, year, month, type])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([gmailMessageId])
}

model LedgerEntry {
  id                 String           @id @default(uuid())
  userId             String
  financialAccountId String
  transactionId      String?
  amount             Decimal          @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  transaction        Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
  @@index([transactionId])
  @@index([userId])
}

model InvestmentGoal {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  month       Int      @default(0)
  goalPercent Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model MonthlyAnalytics {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  month           Int
  totalIncome     Decimal  @default(0) @db.Decimal(18, 2)
  totalExpense    Decimal  @default(0) @db.Decimal(18, 2)
  totalInvestment Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model GmailAccount {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String         @unique
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     GmailMessage[]
}

model GmailMessage {
  id             String        @id @default(uuid())
  gmailMessageId String        @unique
  gmailAccountId String
  gmailAccount   GmailAccount  @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  sender         String?
  subject        String?
  body           String
  processed      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  receivedAt     DateTime?

  @@index([gmailAccountId])
  @@index([processed])
}

model FinancialAccount {
  id                   String               @id @default(uuid())
  userId               String
  name                 String
  type                 FinancialAccountType
  provider             String?
  last4                String
  creditLimit          Decimal?             @db.Decimal(18, 2)
  isActive             Boolean              @default(true)
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  isArchived           Boolean              @default(false)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[]        @relation("SourceAccount")
  incomingTransactions Transaction[]        @relation("DestinationAccount")
  ledgerEntries        LedgerEntry[]
  nickname             String?
  emailMatchers        Json?
  externalReference    String?
  institutionName      String?
  sortOrder            Int                  @default(0)

  @@index([userId, isArchived])
  @@index([userId, name])
  @@index([userId])
  @@index([type])
  @@index([last4])
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum FinancialAccountType {
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  CASH
  INVESTMENT
  LOAN
  WALLET
}

enum TransactionSource {
  MANUAL
  GMAIL
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
}
