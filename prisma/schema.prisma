generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String?
  authProvider      AuthProvider       @default(EMAIL)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categories        Category[]
  financialAccounts FinancialAccount[]
  gmailAccount      GmailAccount?
  investmentGoals   InvestmentGoal[]
  ledgerEntries     LedgerEntry[]
  merchantMappings  MerchantMapping[]
  monthlyAnalytics  MonthlyAnalytics[]
  transactions      Transaction[]
}

model Category {
  id               String            @id @default(uuid())
  userId           String
  name             String
  type             TransactionType
  parentId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryTree")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantMappings MerchantMapping[]
  transactions     Transaction[]

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
}

model Transaction {
  id                       String                   @id @default(uuid())
  userId                   String
  type                     TransactionType
  amount                   Decimal                  @db.Decimal(18, 2)
  date                     DateTime
  year                     Int
  month                    Int
  categoryId               String?
  note                     String?
  idempotencyKey           String?                  @unique
  metadata                 Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  externalReference        String?
  fingerprint              String?                  @unique
  gmailMessageId           String?                  @unique
  source                   TransactionSource        @default(MANUAL)
  destinationAccountId     String?
  sourceAccountId          String?
  currency                 String                   @default("INR")
  exchangeRate             Decimal?                 @db.Decimal(18, 6)
  merchantNormalized       String?
  originalAmount           Decimal?                 @db.Decimal(18, 2)
  status                   TransactionStatus        @default(COMPLETED)
  categoryAssignmentSource CategoryAssignmentSource @default(USER)
  aiCategoryConfidence     Float?
  merchantId               String?
  merchantRaw              String?
  ledgerEntries            LedgerEntry[]
  category                 Category?                @relation(fields: [categoryId], references: [id])
  destinationAccount       FinancialAccount?        @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  gmailMessage             GmailMessage?            @relation(fields: [gmailMessageId], references: [id])
  merchant                 Merchant?                @relation(fields: [merchantId], references: [id])
  sourceAccount            FinancialAccount?        @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, year])
  @@index([userId, year, month])
  @@index([userId, year, month, type])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([gmailMessageId])
  @@index([userId, merchantNormalized])
}

model LedgerEntry {
  id                 String           @id @default(uuid())
  userId             String
  transactionId      String?
  amount             Decimal          @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  transaction        Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
  @@index([transactionId])
  @@index([userId])
}

model InvestmentGoal {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  month       Int      @default(0)
  goalPercent Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model MonthlyAnalytics {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  month           Int
  totalIncome     Decimal  @default(0) @db.Decimal(18, 2)
  totalExpense    Decimal  @default(0) @db.Decimal(18, 2)
  totalInvestment Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model GmailAccount {
  id           String         @id @default(uuid())
  userId       String         @unique
  email        String         @unique
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  historyId    String?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     GmailMessage[]
}

model GmailMessage {
  id             String        @id @default(uuid())
  gmailMessageId String        @unique
  gmailAccountId String
  sender         String?
  subject        String?
  body           String
  processed      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  receivedAt     DateTime?
  gmailAccount   GmailAccount  @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([gmailAccountId])
  @@index([processed])
}

model FinancialAccount {
  id                   String               @id @default(uuid())
  userId               String
  name                 String
  type                 FinancialAccountType
  provider             String?
  last4                String
  creditLimit          Decimal?             @db.Decimal(18, 2)
  isActive             Boolean              @default(true)
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  emailMatchers        Json?
  externalReference    String?
  institutionName      String?
  isArchived           Boolean              @default(false)
  nickname             String?
  sortOrder            Int                  @default(0)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries        LedgerEntry[]
  incomingTransactions Transaction[]        @relation("DestinationAccount")
  outgoingTransactions Transaction[]        @relation("SourceAccount")

  @@index([userId, isArchived])
  @@index([userId, name])
  @@index([userId])
  @@index([type])
  @@index([last4])
}

model MerchantMapping {
  id         String                @id @default(uuid())
  userId     String
  categoryId String
  source     MerchantMappingSource
  confidence Float?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  merchantId String
  category   Category              @relation(fields: [categoryId], references: [id])
  merchant   Merchant              @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User                  @relation(fields: [userId], references: [id])

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model Merchant {
  id               String            @id @default(uuid())
  name             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aliases          MerchantAlias[]
  merchantMappings MerchantMapping[]
  transactions     Transaction[]
}

model MerchantAlias {
  id         String   @id @default(uuid())
  alias      String   @unique
  merchantId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

enum CategoryAssignmentSource {
  USER
  AI_EXISTING
  AI_NEW
}

enum MerchantMappingSource {
  RULE
  AI
  USER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum FinancialAccountType {
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  CASH
  INVESTMENT
  LOAN
  WALLET
}

enum TransactionSource {
  MANUAL
  GMAIL
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
}
