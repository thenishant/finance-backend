{
  "name": "finance-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -e .env.test -- nodemon",
    "db:test:status": "dotenv -e .env.test -- prisma migrate status",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:generate": "prisma generate",
    "prod": "dotenv -e .env.prod -- node dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- vitest",
    "test:watch": "dotenv -e .env.test -- vitest",
    "postinstall": "prisma generate",
    "prisma-migrate": "npx prisma migrate dev",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "gmail:backfill": "dotenv -e .env.prod -- tsx src/scripts/backfill-gmail-transactions.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.2.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "mongoose": "^9.2.1",
    "node-cron": "^4.6.0",
    "openai": "^6.48.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
